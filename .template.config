# .template.config — populated by .github/workflows/init.yml on first run.
# CI reads this file to decide which platform jobs to spawn.
# Keys:
#   PROJECT_NAME    — human-readable project name.
#   PACKAGE_NAME    — dotted Kotlin/Android package (e.g. com.myapp).
#   INCLUDE_ANDROID — true|false
#   INCLUDE_IOS     — true|false
#   INCLUDE_WEB     — true|false
#   INCLUDE_DESKTOP — true|false
PROJECT_NAME={{PROJECT_NAME}}
PACKAGE_NAME={{PACKAGE_NAME}}
INCLUDE_ANDROID=true
INCLUDE_IOS=true
INCLUDE_WEB=true
INCLUDE_DESKTOP=true

